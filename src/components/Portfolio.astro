---
import type { ImageMetadata } from 'astro';

import proyectoPos from '../images/proyecto-pos.jpg';
import proyectoGym from '../images/proyecto-gym.jpg';
import proyectoWeb from '../images/proyecto-web.jpg';
import proyectoWeb2 from '../images/proyecto-web-2.jpg';
import proyectoWeb3 from '../images/proyecto-web-3.jpg';
import proyectoDashboard from '../images/proyecto-dashboard.jpg';
import proyectoCloud from '../images/proyecto-cloud.jpg';
import proyectoApp from '../images/proyecto-app.jpeg';
import proyectoApp2 from '../images/proyecto-app-2.jpeg';

type ProjectType = 'image' | 'web-slider' | 'app-slider';

interface Project {
  title: string;
  shortTitle: string;
  category: string;
  description: string;
  features: string[];
  image: ImageMetadata;
  images?: ImageMetadata[];
  type: ProjectType;
  demoUrl?: string;
  requestDemo?: boolean;
}

const projects: Project[] = [
  {
    title: 'Sistema de punto de venta',
    shortTitle: 'Punto de venta',
    category: 'Ventas y operación',
    description:
      'Una herramienta para registrar ventas, controlar productos, revisar inventario y consultar resultados desde un solo lugar.',
    features: [
      'Ventas rápidas',
      'Inventario actualizado',
      'Tickets y cortes',
      'Reportes claros',
    ],
    image: proyectoPos,
    type: 'image',
  },
  {
    title: 'Sistema para gimnasios',
    shortTitle: 'Sistema para gimnasios',
    category: 'Membresías y accesos',
    description:
      'Una plataforma para administrar socios, membresías, pagos, accesos, sucursales y actividades diarias desde un panel sencillo.',
    features: [
      'Control de socios',
      'Pagos y membresías',
      'Accesos con código QR',
      'Administración por sucursal',
    ],
    image: proyectoGym,
    type: 'image',
    demoUrl: 'https://demogym.rexcoresolutions.com/registro.php',
    requestDemo: true,
  },
  {
    title: 'Páginas web profesionales',
    shortTitle: 'Páginas web',
    category: 'Presencia digital',
    description:
      'Sitios claros, rápidos y adaptados a celular para presentar servicios, generar confianza y facilitar el contacto con nuevos clientes.',
    features: [
      'Diseño responsivo',
      'Contenido fácil de entender',
      'Formulario de contacto',
      'Publicación y dominio',
    ],
    image: proyectoWeb,
    images: [proyectoWeb, proyectoWeb2, proyectoWeb3],
    type: 'web-slider',
    demoUrl: 'https://wheat-gnat-631766.hostingersite.com/',
  },
  {
    title: 'Paneles de información',
    shortTitle: 'Paneles y reportes',
    category: 'Decisiones más claras',
    description:
      'Paneles que convierten ventas, clientes y operaciones en información visual para entender mejor lo que sucede en el negocio.',
    features: [
      'Indicadores importantes',
      'Filtros sencillos',
      'Gráficas',
      'Reportes administrativos',
    ],
    image: proyectoDashboard,
    type: 'image',
  },
  {
    title: 'Aplicaciones móviles',
    shortTitle: 'Aplicaciones móviles',
    category: 'Android y iPhone',
    description:
      'Aplicaciones prácticas para que clientes o colaboradores consulten información y realicen tareas desde su teléfono.',
    features: [
      'Android y iPhone',
      'Diseño fácil de usar',
      'Avisos y notificaciones',
      'Conexión con sistemas',
    ],
    image: proyectoApp,
    images: [proyectoApp, proyectoApp2],
    type: 'app-slider',
  },
  {
    title: 'Publicación y respaldo',
    shortTitle: 'Infraestructura digital',
    category: 'Operación segura',
    description:
      'Configuración de dominio, alojamiento, respaldos y publicación para mantener páginas y sistemas disponibles y protegidos.',
    features: ['Dominio', 'Alojamiento', 'Respaldos', 'Publicación segura'],
    image: proyectoCloud,
    type: 'image',
  },
];
---

<section
  id="portafolio"
  class="rex-portfolio relative overflow-hidden bg-[#f8fbff] py-20 sm:py-24 lg:py-28"
>
  <div
    class="pointer-events-none absolute left-1/2 top-16 h-[440px] w-[900px] -translate-x-1/2 rounded-full bg-blue-100/70 blur-3xl"
  ></div>

  <div class="relative mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="inline-flex rounded-full border border-blue-100 bg-white px-4 py-2 text-sm font-extrabold text-blue-700 shadow-sm"
      >
        Proyectos y soluciones
      </span>

      <h2
        class="mt-5 text-3xl font-black tracking-[-0.035em] text-slate-950 sm:text-4xl lg:text-5xl"
      >
        Herramientas pensadas para hacer más sencillo tu negocio.
      </h2>

      <p class="mt-5 text-base leading-8 text-slate-600 sm:text-lg">
        Conoce algunos ejemplos de páginas, sistemas y aplicaciones que ayudan a
        vender, organizar información y atender mejor a los clientes.
      </p>

      <p class="mt-4 hidden text-sm font-bold text-blue-700 lg:block">
        Arrastra la galería para explorar los proyectos.
      </p>
    </div>

    <!-- Solo escritorio -->
    <div id="rexCarouselStage" class="rex-carousel-stage mt-10">
      <div id="rexCarousel3d" class="rex-carousel-3d">
        {
          projects.map((project, index) => (
            <article
              class="rex-project-card"
              style={`--i:${index};`}
              tabindex="0"
              role="button"
              aria-label={`Ver detalles de ${project.title}`}
              data-rex-project-card
              data-title={project.title}
              data-category={project.category}
              data-description={project.description}
              data-features={project.features.join('|')}
              data-demo-url={project.demoUrl ?? ''}
              data-request-demo={project.requestDemo ? 'true' : 'false'}
            >
              <div class="rex-card-media">
                {project.type === 'web-slider' ? (
                  <div class="rex-web-slider" data-rex-web-slider>
                    {(project.images ?? [project.image]).map(
                      (image, imageIndex) => (
                        <img
                          src={image.src}
                          class:list={[imageIndex === 0 && 'active']}
                          alt={`${project.title} ${imageIndex + 1}`}
                          loading="lazy"
                          decoding="async"
                        />
                      ),
                    )}
                  </div>
                ) : project.type === 'app-slider' ? (
                  <div class="rex-app-background">
                    <div class="rex-phone-preview">
                      <div class="rex-app-slider" data-rex-app-slider>
                        {(project.images ?? [project.image]).map(
                          (image, imageIndex) => (
                            <img
                              src={image.src}
                              class:list={[
                                'rex-app-image',
                                imageIndex === 0 && 'active',
                              ]}
                              alt={`${project.title} ${imageIndex + 1}`}
                              loading="lazy"
                              decoding="async"
                            />
                          ),
                        )}
                      </div>
                    </div>
                  </div>
                ) : (
                  <img
                    src={project.image.src}
                    alt={project.title}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>

              <div class="rex-card-content">
                <span>{project.category}</span>
                <h3>{project.shortTitle}</h3>
                <p>{project.description}</p>

                <div class="rex-card-link">
                  Conocer el proyecto
                  <span aria-hidden="true">→</span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Móvil y tableta: sin carrusel -->
    <div class="rex-mobile-projects mt-10">
      {
        projects.map((project) => (
          <article
            class="rex-mobile-card"
            data-rex-project-card
            data-title={project.title}
            data-category={project.category}
            data-description={project.description}
            data-features={project.features.join('|')}
            data-demo-url={project.demoUrl ?? ''}
            data-request-demo={project.requestDemo ? 'true' : 'false'}
          >
            <button
              type="button"
              class="rex-mobile-card-button"
              aria-label={`Ver detalles de ${project.title}`}
            >
              <div class="rex-mobile-card-media">
                {project.type === 'web-slider' ? (
                  <div
                    class="rex-mobile-image-slider"
                    data-rex-mobile-web-slider
                  >
                    {(project.images ?? [project.image]).map(
                      (image, imageIndex) => (
                        <img
                          src={image.src}
                          class:list={[
                            'rex-mobile-slide',
                            imageIndex === 0 && 'active',
                          ]}
                          alt={`${project.title} ${imageIndex + 1}`}
                          loading="lazy"
                          decoding="async"
                        />
                      ),
                    )}
                  </div>
                ) : project.type === 'app-slider' ? (
                  <div class="rex-mobile-app-preview">
                    <div class="rex-mobile-phone">
                      <div
                        class="rex-mobile-app-slider"
                        data-rex-mobile-app-slider
                      >
                        {(project.images ?? [project.image]).map(
                          (image, imageIndex) => (
                            <img
                              src={image.src}
                              class:list={[
                                'rex-mobile-app-image',
                                imageIndex === 0 && 'active',
                              ]}
                              alt={`${project.title} ${imageIndex + 1}`}
                              loading="lazy"
                              decoding="async"
                            />
                          ),
                        )}
                      </div>
                    </div>
                  </div>
                ) : (
                  <img
                    src={project.image.src}
                    alt={project.title}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>

              <div class="rex-mobile-card-content">
                <span>{project.category}</span>
                <h3>{project.shortTitle}</h3>
                <p>{project.description}</p>

                <div class="rex-mobile-card-link">
                  Ver detalles
                  <span aria-hidden="true">→</span>
                </div>
              </div>
            </button>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Modal de detalles -->
<div class="rex-project-modal" id="rexProjectModal" aria-hidden="true">
  <button
    class="rex-project-modal-backdrop"
    type="button"
    data-rex-modal-close
    aria-label="Cerrar detalle"
  ></button>

  <div
    class="rex-project-modal-content"
    role="dialog"
    aria-modal="true"
    aria-labelledby="rexModalTitle"
  >
    <button
      class="rex-project-modal-close"
      id="rexProjectModalClose"
      type="button"
      aria-label="Cerrar"
    >
      ×
    </button>

    <span id="rexModalCategory" class="rex-modal-category"></span>
    <h3 id="rexModalTitle" class="rex-modal-title"></h3>
    <p id="rexModalDescription" class="rex-modal-description"></p>

    <div class="rex-modal-features" id="rexModalFeatures"></div>

    <div class="rex-modal-actions">
      <a
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="rex-demo-button"
        id="rexModalDemoButton"
      >
        Acceder a la demo
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5h5v5m0-5-9 9M5 8v11h11v-5"
          ></path>
        </svg>
      </a>

      <button
        type="button"
        class="rex-request-demo-button"
        id="rexRequestDemoButton"
        aria-expanded="false"
        aria-controls="rexDemoRequestPanel"
      >
        Solicitar demo
      </button>
    </div>

    <div class="rex-demo-request-panel" id="rexDemoRequestPanel" hidden>
      <div class="rex-request-heading">
        <h4>Solicita una demostración</h4>
        <p>
          Déjanos tu nombre y correo. Nos comunicaremos contigo para mostrarte el
          sistema.
        </p>
      </div>

      <form
        id="rexDemoRequestForm"
        action="https://formspree.io/f/xaqzanwj"
        method="POST"
      >
        <input type="hidden" name="_subject" value="Nueva solicitud de demo" />
        <input type="hidden" name="proyecto" id="rexDemoProjectInput" value="" />
        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          class="rex-honeypot"
          aria-hidden="true"
        />

        <div class="rex-form-field">
          <label for="rexDemoName">Nombre completo</label>
          <input
            id="rexDemoName"
            name="name"
            type="text"
            placeholder="Escribe tu nombre"
            autocomplete="name"
            required
          />
        </div>

        <div class="rex-form-field">
          <label for="rexDemoEmail">Correo electrónico</label>
          <input
            id="rexDemoEmail"
            name="email"
            type="email"
            placeholder="correo@empresa.com"
            autocomplete="email"
            required
          />
        </div>

        <button type="submit" class="rex-submit-demo-button">
          <span data-rex-submit-label>Enviar solicitud</span>
          <span data-rex-submit-loading hidden>Enviando...</span>
        </button>

        <p
          class="rex-form-message"
          id="rexDemoFormMessage"
          role="status"
          aria-live="polite"
        ></p>
      </form>
    </div>
  </div>
</div>

<style>
  .rex-portfolio *,
  .rex-project-modal * {
    box-sizing: border-box;
  }

  /* =========================
     CARRUSEL DE ESCRITORIO
     ========================= */
  .rex-carousel-stage {
    position: relative;
    display: flex;
    height: 610px;
    align-items: center;
    justify-content: center;
    perspective: 1800px;
    cursor: grab;
    user-select: none;
    touch-action: pan-y;
  }

  .rex-carousel-stage:active {
    cursor: grabbing;
  }

  .rex-carousel-3d {
    position: relative;
    width: 350px;
    height: 470px;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .rex-project-card {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: 245px 1fr;
    overflow: hidden;
    border: 1px solid #dbe6f3;
    border-radius: 30px;
    background: #ffffff;
    box-shadow:
      0 28px 75px rgba(30, 64, 175, 0.16),
      0 8px 24px rgba(15, 23, 42, 0.08);
    transform: rotateY(calc(var(--i) * 60deg)) translateZ(420px);
    backface-visibility: hidden;
    cursor: pointer;
    outline: none;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .rex-project-card:hover {
    border-color: #93c5fd;
  }

  .rex-project-card:focus-visible {
    box-shadow:
      0 0 0 5px rgba(59, 130, 246, 0.24),
      0 28px 75px rgba(30, 64, 175, 0.16);
  }

  .rex-card-media {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid #e5edf7;
    background: linear-gradient(145deg, #eef6ff, #ffffff);
  }

  .rex-card-media > img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 14px;
    pointer-events: none;
    user-select: none;
  }

  .rex-card-content {
    display: flex;
    min-height: 0;
    flex-direction: column;
    padding: 23px 24px 22px;
    background: #ffffff;
  }

  .rex-card-content > span {
    color: #2563eb;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .rex-card-content h3 {
    margin: 8px 0 0;
    color: #0f172a;
    font-size: 25px;
    font-weight: 950;
    line-height: 1.08;
  }

  .rex-card-content p {
    display: -webkit-box;
    margin: 11px 0 0;
    overflow: hidden;
    color: #64748b;
    font-size: 13px;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .rex-card-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 14px;
    color: #1d4ed8;
    font-size: 13px;
    font-weight: 900;
  }

  .rex-card-link span {
    transition: transform 0.2s ease;
  }

  .rex-project-card:hover .rex-card-link span {
    transform: translateX(4px);
  }

  /* Sliders dentro de tarjetas */
  .rex-web-slider {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: linear-gradient(145deg, #eff6ff, #ffffff);
  }

  .rex-web-slider img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 92%;
    height: 84%;
    object-fit: contain;
    border-radius: 12px;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.98);
    transition:
      opacity 0.8s ease,
      transform 1s ease;
  }

  .rex-web-slider img.active {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .rex-app-background {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, #eff6ff, #ede9fe);
  }

  .rex-phone-preview {
    position: relative;
    width: 43%;
    height: 82%;
    overflow: hidden;
    border: 6px solid #172033;
    border-radius: 27px;
    background: #172033;
    box-shadow: 0 22px 44px rgba(15, 23, 42, 0.2);
    transform: perspective(900px) rotateY(-6deg) rotateX(2deg);
    transition: transform 0.4s ease;
  }

  .rex-project-card:hover .rex-phone-preview {
    transform: perspective(900px) rotateY(0deg) rotateX(0deg) scale(1.02);
  }

  .rex-phone-preview::before {
    content: '';
    position: absolute;
    z-index: 4;
    top: 7px;
    left: 50%;
    width: 34%;
    height: 10px;
    border-radius: 999px;
    background: #172033;
    transform: translateX(-50%);
  }

  .rex-app-slider {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 20px;
  }

  .rex-app-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.05);
    transition:
      opacity 0.8s ease,
      transform 1.1s ease;
  }

  .rex-app-image.active {
    opacity: 1;
    transform: scale(1);
  }

  /* =========================
     TARJETAS MÓVILES
     ========================= */
  .rex-mobile-projects {
    display: none;
    gap: 18px;
  }

  .rex-mobile-card {
    overflow: hidden;
    border: 1px solid #dce7f3;
    border-radius: 26px;
    background: #ffffff;
    box-shadow: 0 14px 38px rgba(15, 23, 42, 0.08);
  }

  .rex-mobile-card-button {
    display: block;
    width: 100%;
    border: 0;
    background: transparent;
    padding: 0;
    text-align: left;
    cursor: pointer;
  }

  .rex-mobile-card-media {
    height: 210px;
    overflow: hidden;
    border-bottom: 1px solid #e5edf7;
    background: linear-gradient(145deg, #eff6ff, #ffffff);
  }

  .rex-mobile-card-media > img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 12px;
  }

  .rex-mobile-image-slider {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: linear-gradient(145deg, #eff6ff, #ffffff);
  }

  .rex-mobile-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 12px;
    opacity: 0;
    transform: scale(0.985);
    transition:
      opacity 0.8s ease,
      transform 1s ease;
  }

  .rex-mobile-slide.active {
    opacity: 1;
    transform: scale(1);
  }

  .rex-mobile-card-content {
    padding: 20px;
  }

  .rex-mobile-card-content > span {
    color: #2563eb;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .rex-mobile-card-content h3 {
    margin: 7px 0 0;
    color: #0f172a;
    font-size: 22px;
    font-weight: 950;
    line-height: 1.14;
  }

  .rex-mobile-card-content p {
    margin: 10px 0 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.65;
  }

  .rex-mobile-card-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 17px;
    color: #1d4ed8;
    font-size: 14px;
    font-weight: 900;
  }

  .rex-mobile-app-preview {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, #eff6ff, #ede9fe);
  }

  .rex-mobile-phone {
    position: relative;
    width: 105px;
    height: 184px;
    overflow: hidden;
    border: 6px solid #172033;
    border-radius: 24px;
    background: #172033;
    box-shadow: 0 17px 35px rgba(15, 23, 42, 0.2);
  }

  .rex-mobile-app-slider {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 17px;
  }

  .rex-mobile-app-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 17px;
    opacity: 0;
    transform: scale(1.05);
    transition:
      opacity 0.8s ease,
      transform 1s ease;
  }

  .rex-mobile-app-image.active {
    opacity: 1;
    transform: scale(1);
  }

  /* =========================
     MODAL CLARO
     ========================= */
  .rex-project-modal {
    position: fixed;
    z-index: 99999;
    inset: 0;
    display: none;
    place-items: center;
    padding: 18px;
  }

  .rex-project-modal.active {
    display: grid;
  }

  .rex-project-modal-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: rgba(15, 23, 42, 0.48);
    backdrop-filter: blur(10px);
    cursor: default;
  }

  .rex-project-modal-content {
    position: relative;
    width: min(600px, 100%);
    max-height: calc(100dvh - 36px);
    overflow-y: auto;
    border: 1px solid #dbe6f3;
    border-radius: 30px;
    background: #ffffff;
    padding: 32px;
    box-shadow: 0 32px 90px rgba(15, 23, 42, 0.24);
    animation: rex-modal-in 0.22s ease;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }

  .rex-project-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: inline-flex;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    border: 1px solid #dbe6f3;
    border-radius: 999px;
    background: #f8fafc;
    color: #0f172a;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }

  .rex-project-modal-close:hover {
    background: #eff6ff;
    color: #1d4ed8;
  }

  .rex-modal-category {
    display: inline-flex;
    max-width: calc(100% - 58px);
    border-radius: 999px;
    background: #eaf2ff;
    padding: 8px 13px;
    color: #1d4ed8;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .rex-modal-title {
    margin: 18px 0 0;
    padding-right: 42px;
    color: #0f172a;
    font-size: clamp(1.75rem, 5vw, 2.35rem);
    font-weight: 950;
    line-height: 1.08;
  }

  .rex-modal-description {
    margin: 16px 0 0;
    color: #526176;
    font-size: 16px;
    line-height: 1.75;
  }

  .rex-modal-features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 23px;
  }

  .rex-modal-features span {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
    border: 1px solid #e5edf7;
    border-radius: 15px;
    background: #f8fbff;
    padding: 12px;
    color: #334155;
    font-size: 13px;
    font-weight: 800;
  }

  .rex-modal-features span::before {
    content: '✓';
    display: inline-flex;
    width: 21px;
    height: 21px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #dbeafe;
    color: #1d4ed8;
    font-size: 11px;
    font-weight: 950;
  }

  .rex-modal-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 11px;
    margin-top: 24px;
  }

  .rex-demo-button,
  .rex-request-demo-button {
    display: none;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 14px;
    padding: 13px 17px;
    font-size: 14px;
    font-weight: 900;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .rex-demo-button.active {
    display: inline-flex;
    border: 1px solid #1d4ed8;
    background: #1d4ed8;
    color: #ffffff;
  }

  .rex-demo-button:hover {
    background: #1e40af;
    transform: translateY(-1px);
  }

  .rex-request-demo-button.active {
    display: inline-flex;
    border: 1px solid #bfdbfe;
    background: #eff6ff;
    color: #1d4ed8;
  }

  .rex-request-demo-button:hover {
    border-color: #93c5fd;
    background: #dbeafe;
    transform: translateY(-1px);
  }

  /* Formulario de solicitud */
  .rex-demo-request-panel {
    margin-top: 22px;
    border: 1px solid #dbe6f3;
    border-radius: 22px;
    background: #f8fbff;
    padding: 21px;
  }

  .rex-demo-request-panel[hidden] {
    display: none !important;
  }

  .rex-request-heading h4 {
    margin: 0;
    color: #0f172a;
    font-size: 19px;
    font-weight: 950;
  }

  .rex-request-heading p {
    margin: 6px 0 0;
    color: #64748b;
    font-size: 13px;
    line-height: 1.6;
  }

  #rexDemoRequestForm {
    display: grid;
    gap: 15px;
    margin-top: 18px;
  }

  .rex-form-field {
    display: grid;
    gap: 7px;
  }

  .rex-form-field label {
    color: #334155;
    font-size: 13px;
    font-weight: 850;
  }

  .rex-form-field input {
    width: 100%;
    min-height: 48px;
    border: 1px solid #d7e2ef;
    border-radius: 13px;
    background: #ffffff;
    padding: 12px 14px;
    color: #0f172a;
    font: inherit;
    font-size: 14px;
    outline: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .rex-form-field input::placeholder {
    color: #94a3b8;
  }

  .rex-form-field input:focus {
    border-color: #60a5fa;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
  }

  .rex-submit-demo-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 13px;
    background: #0f172a;
    padding: 13px 18px;
    color: #ffffff;
    font: inherit;
    font-size: 14px;
    font-weight: 900;
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .rex-submit-demo-button:hover {
    background: #1e293b;
    transform: translateY(-1px);
  }

  .rex-submit-demo-button:disabled {
    cursor: wait;
    opacity: 0.7;
    transform: none;
  }

  .rex-form-message {
    min-height: 20px;
    margin: 0;
    font-size: 13px;
    font-weight: 800;
  }

  .rex-form-message.success {
    color: #047857;
  }

  .rex-form-message.error {
    color: #b91c1c;
  }

  .rex-honeypot {
    position: absolute !important;
    left: -9999px !important;
    width: 1px !important;
    height: 1px !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  @keyframes rex-modal-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* El carrusel jamás aparece en móvil o tableta */
  @media (max-width: 1023px) {
    .rex-carousel-stage {
      display: none !important;
      visibility: hidden !important;
      height: 0 !important;
      margin: 0 !important;
      overflow: hidden !important;
      pointer-events: none !important;
    }

    .rex-mobile-projects {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .rex-mobile-projects {
      display: none !important;
    }
  }

  @media (max-width: 680px) {
    .rex-mobile-projects {
      grid-template-columns: 1fr;
    }

    .rex-mobile-card-media {
      height: 205px;
    }

    .rex-project-modal {
      align-items: end;
      padding: 10px;
    }

    .rex-project-modal-content {
      width: 100%;
      max-height: calc(100dvh - 20px);
      border-radius: 25px 25px 18px 18px;
      padding: 25px 20px 20px;
    }

    .rex-modal-features,
    .rex-modal-actions {
      grid-template-columns: 1fr;
    }

    .rex-modal-title {
      padding-right: 38px;
    }

    .rex-demo-request-panel {
      padding: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rex-project-card,
    .rex-card-link span,
    .rex-web-slider img,
    .rex-app-image,
    .rex-mobile-slide,
    .rex-mobile-app-image,
    .rex-demo-button,
    .rex-request-demo-button,
    .rex-submit-demo-button {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  const rexStage = document.getElementById('rexCarouselStage');
  const rexCarousel = document.getElementById('rexCarousel3d');

  const rexModal = document.getElementById('rexProjectModal');
  const rexModalClose = document.getElementById('rexProjectModalClose');
  const rexModalCategory = document.getElementById('rexModalCategory');
  const rexModalTitle = document.getElementById('rexModalTitle');
  const rexModalDescription = document.getElementById('rexModalDescription');
  const rexModalFeatures = document.getElementById('rexModalFeatures');
  const rexModalDemoButton = document.getElementById('rexModalDemoButton');

  const rexRequestDemoButton = document.getElementById(
    'rexRequestDemoButton',
  );
  const rexDemoRequestPanel = document.getElementById(
    'rexDemoRequestPanel',
  );
  const rexDemoRequestForm = document.getElementById(
    'rexDemoRequestForm',
  );
  const rexDemoProjectInput = document.getElementById(
    'rexDemoProjectInput',
  );
  const rexDemoFormMessage = document.getElementById(
    'rexDemoFormMessage',
  );

  const rexProjectCards = document.querySelectorAll(
    '[data-rex-project-card]',
  );

  let rexRotation = 0;
  let rexVelocity = -0.045;
  let rexIsDragging = false;
  let rexHasMoved = false;
  let rexStartX = 0;
  let rexLastX = 0;
  let rexLastTime = 0;
  let rexPressedCard = null;
  let rexAnimationFrame = null;

  function rexResetDemoFormState() {
    if (rexDemoRequestPanel) {
      rexDemoRequestPanel.hidden = true;
    }

    rexRequestDemoButton?.setAttribute('aria-expanded', 'false');

    if (rexDemoFormMessage) {
      rexDemoFormMessage.textContent = '';
      rexDemoFormMessage.className = 'rex-form-message';
    }
  }

  function rexOpenModal(card) {
    if (!rexModal || !card) return;

    const title = card.dataset.title || '';

    rexModalCategory.textContent = card.dataset.category || '';
    rexModalTitle.textContent = title;
    rexModalDescription.textContent = card.dataset.description || '';
    rexModalFeatures.innerHTML = '';

    const features = (card.dataset.features || '')
      .split('|')
      .filter(Boolean);

    features.forEach((feature) => {
      const item = document.createElement('span');
      item.textContent = feature.trim();
      rexModalFeatures.appendChild(item);
    });

    const demoUrl = card.dataset.demoUrl || '';
    if (demoUrl) {
      rexModalDemoButton.href = demoUrl;
      rexModalDemoButton.classList.add('active');
    } else {
      rexModalDemoButton.removeAttribute('href');
      rexModalDemoButton.classList.remove('active');
    }

    const canRequestDemo = card.dataset.requestDemo === 'true';
    rexRequestDemoButton.classList.toggle('active', canRequestDemo);

    if (rexDemoProjectInput) {
      rexDemoProjectInput.value = title;
    }

    rexResetDemoFormState();

    rexModal.classList.add('active');
    rexModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    window.setTimeout(() => rexModalClose?.focus(), 50);
  }

  function rexCloseModal() {
    if (!rexModal) return;

    rexModal.classList.remove('active');
    rexModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';

    rexResetDemoFormState();
  }

  rexProjectCards.forEach((card) => {
    if (!card.closest('#rexCarouselStage')) {
      card
        .querySelector('button')
        ?.addEventListener('click', () => rexOpenModal(card));
    }

    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        rexOpenModal(card);
      }
    });
  });

  function rexAnimateCarousel() {
    if (!rexCarousel) return;

    if (!rexIsDragging) {
      rexRotation += rexVelocity;
      rexVelocity *= 0.987;

      if (Math.abs(rexVelocity) < 0.045) {
        rexVelocity = rexVelocity < 0 ? -0.045 : 0.045;
      }
    }

    rexCarousel.style.transform = `rotateY(${rexRotation}deg)`;
    rexAnimationFrame =
      window.requestAnimationFrame(rexAnimateCarousel);
  }

  if (
    rexStage &&
    rexCarousel &&
    window.matchMedia('(min-width: 1024px)').matches
  ) {
    rexStage.addEventListener('pointerdown', (event) => {
      rexIsDragging = true;
      rexHasMoved = false;
      rexPressedCard = event.target.closest('.rex-project-card');

      rexStartX = event.clientX;
      rexLastX = event.clientX;
      rexLastTime = performance.now();
      rexVelocity = 0;

      rexStage.setPointerCapture?.(event.pointerId);
    });

    rexStage.addEventListener('pointermove', (event) => {
      if (!rexIsDragging) return;

      const now = performance.now();
      const deltaX = event.clientX - rexLastX;
      const totalDistance = Math.abs(event.clientX - rexStartX);
      const deltaTime = Math.max(now - rexLastTime, 16);

      if (totalDistance > 8) {
        rexHasMoved = true;
      }

      rexRotation += deltaX * 0.12;
      rexVelocity = Math.max(
        -1.1,
        Math.min(1.1, (deltaX / deltaTime) * 1.45),
      );

      rexLastX = event.clientX;
      rexLastTime = now;
    });

    rexStage.addEventListener('pointerup', (event) => {
      if (!rexIsDragging) return;

      rexIsDragging = false;
      rexStage.releasePointerCapture?.(event.pointerId);

      if (!rexHasMoved && rexPressedCard) {
        rexOpenModal(rexPressedCard);
      }

      rexPressedCard = null;
    });

    rexStage.addEventListener('pointercancel', () => {
      rexIsDragging = false;
      rexPressedCard = null;
    });

    rexStage.addEventListener('pointerleave', () => {
      if (!rexIsDragging) return;
      rexIsDragging = false;
      rexPressedCard = null;
    });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      rexAnimateCarousel();
    } else {
      rexCarousel.style.transform = 'rotateY(0deg)';
    }
  }

  rexModalClose?.addEventListener('click', rexCloseModal);

  rexModal
    ?.querySelectorAll('[data-rex-modal-close]')
    .forEach((button) =>
      button.addEventListener('click', rexCloseModal),
    );

  rexRequestDemoButton?.addEventListener('click', () => {
    if (!rexDemoRequestPanel) return;

    const willOpen = rexDemoRequestPanel.hidden;
    rexDemoRequestPanel.hidden = !willOpen;
    rexRequestDemoButton.setAttribute(
      'aria-expanded',
      willOpen ? 'true' : 'false',
    );

    if (willOpen) {
      window.setTimeout(() => {
        document.getElementById('rexDemoName')?.focus();
        rexDemoRequestPanel.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest',
        });
      }, 50);
    }
  });

  rexDemoRequestForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const form = event.currentTarget;
    const submitButton = form.querySelector(
      '.rex-submit-demo-button',
    );
    const submitLabel = form.querySelector(
      '[data-rex-submit-label]',
    );
    const submitLoading = form.querySelector(
      '[data-rex-submit-loading]',
    );

    submitButton.disabled = true;
    submitLabel.hidden = true;
    submitLoading.hidden = false;

    rexDemoFormMessage.textContent = '';
    rexDemoFormMessage.className = 'rex-form-message';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: {
          Accept: 'application/json',
        },
      });

      if (!response.ok) {
        throw new Error('No fue posible enviar la solicitud.');
      }

      form.reset();

      if (rexDemoProjectInput) {
        rexDemoProjectInput.value =
          rexModalTitle?.textContent || 'Sistema para gimnasios';
      }

      rexDemoFormMessage.textContent =
        'Solicitud enviada correctamente. Nos comunicaremos contigo pronto.';
      rexDemoFormMessage.classList.add('success');
    } catch (error) {
      rexDemoFormMessage.textContent =
        'No fue posible enviar la solicitud. Revisa tus datos e inténtalo nuevamente.';
      rexDemoFormMessage.classList.add('error');
    } finally {
      submitButton.disabled = false;
      submitLabel.hidden = false;
      submitLoading.hidden = true;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (
      event.key === 'Escape' &&
      rexModal?.classList.contains('active')
    ) {
      rexCloseModal();
    }
  });

  function rexRotateSlider(sliderSelector, imageSelector) {
    document.querySelectorAll(sliderSelector).forEach((slider) => {
      const images = slider.querySelectorAll(imageSelector);

      if (images.length < 2) return;

      let current = 0;

      window.setInterval(() => {
        images[current]?.classList.remove('active');
        current = (current + 1) % images.length;
        images[current]?.classList.add('active');
      }, 3200);
    });
  }

  rexRotateSlider('[data-rex-web-slider]', 'img');
  rexRotateSlider('[data-rex-app-slider]', '.rex-app-image');
  rexRotateSlider(
    '[data-rex-mobile-web-slider]',
    '.rex-mobile-slide',
  );
  rexRotateSlider(
    '[data-rex-mobile-app-slider]',
    '.rex-mobile-app-image',
  );

  document.addEventListener('astro:before-swap', () => {
    if (rexAnimationFrame) {
      window.cancelAnimationFrame(rexAnimationFrame);
    }

    document.body.style.overflow = '';
  });
</script>
