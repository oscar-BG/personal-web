---
type Accent = 'blue' | 'orange' | 'green';
type ServiceIcon = 'window' | 'system' | 'phone';

interface Service {
  number: string;
  title: string;
  description: string;
  audience: string;
  features: string[];
  accent: Accent;
  icon: ServiceIcon;
}

const services: Service[] = [
  {
    number: '01',
    title: 'Una página web que genere confianza',
    description:
      'Presenta tu negocio de forma profesional, explica mejor lo que haces y facilita que nuevos clientes te contacten.',
    audience: 'Ideal para negocios, profesionistas y marcas',
    features: [
      'Diseño adaptable a celular',
      'Formulario de contacto',
      'Dominio y publicación',
      'Contenido fácil de entender',
    ],
    accent: 'blue',
    icon: 'window',
  },
  {
    number: '02',
    title: 'Un sistema que ordene tu operación',
    description:
      'Reunimos clientes, ventas, inventario, pagos o reportes en una herramienta diseñada alrededor de tu forma de trabajar.',
    audience: 'Ideal para empresas con procesos manuales',
    features: [
      'Menos capturas repetidas',
      'Información centralizada',
      'Accesos por usuario',
      'Reportes claros',
    ],
    accent: 'orange',
    icon: 'system',
  },
  {
    number: '03',
    title: 'Una aplicación para estar más cerca',
    description:
      'Creamos aplicaciones móviles prácticas para que tus clientes o tu equipo puedan realizar tareas desde cualquier lugar.',
    audience: 'Ideal para servicios y equipos en movimiento',
    features: [
      'Android y iPhone',
      'Experiencia sencilla',
      'Avisos y seguimiento',
      'Conexión con tu sistema',
    ],
    accent: 'green',
    icon: 'phone',
  },
];

const accentClasses: Record<
  Accent,
  {
    badge: string;
    icon: string;
    check: string;
    hover: string;
  }
> = {
  blue: {
    badge: 'bg-blue-100 text-blue-700',
    icon: 'bg-blue-700 text-white',
    check: 'bg-blue-100 text-blue-700',
    hover: 'hover:border-blue-300',
  },
  orange: {
    badge: 'bg-orange-100 text-orange-700',
    icon: 'bg-orange-500 text-white',
    check: 'bg-orange-100 text-orange-700',
    hover: 'hover:border-orange-300',
  },
  green: {
    badge: 'bg-emerald-100 text-emerald-700',
    icon: 'bg-emerald-600 text-white',
    check: 'bg-emerald-100 text-emerald-700',
    hover: 'hover:border-emerald-300',
  },
};
---

<section id="servicios" class="bg-white py-20 sm:py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
      <div>
        <span class="inline-flex rounded-full bg-blue-50 px-4 py-2 text-sm font-bold text-blue-700">Qué podemos crear contigo</span>
        <h2 class="mt-5 max-w-xl text-3xl font-black tracking-[-0.035em] text-slate-950 sm:text-4xl lg:text-5xl">
          Tecnología que resuelve problemas reales.
        </h2>
      </div>
      <p class="max-w-2xl text-base leading-8 text-slate-600 lg:ml-auto lg:text-lg">
        No necesitas saber de programación. Tú nos cuentas qué quieres mejorar y nosotros te proponemos una solución clara, útil y fácil de usar.
      </p>
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {services.map((service) => {
        const colors = accentClasses[service.accent];
        return (
          <article class:list={['group flex h-full flex-col rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl sm:p-8', colors.hover]}>
            <div class="flex items-center justify-between gap-4">
              <div class:list={['flex h-12 w-12 items-center justify-center rounded-2xl', colors.icon]}>
                {service.icon === 'window' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5h16v14H4zM4 9h16M8 7h.01M11 7h.01" />
                  </svg>
                )}
                {service.icon === 'system' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h7M4 18h10M15 10l2-2 3 3-5 5-2 .5.5-2z" />
                  </svg>
                )}
                {service.icon === 'phone' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 3h8a2 2 0 012 2v14a2 2 0 01-2 2H8a2 2 0 01-2-2V5a2 2 0 012-2zm3 15h2" />
                  </svg>
                )}
              </div>
              <span class:list={['rounded-full px-3 py-1.5 text-xs font-black', colors.badge]}>{service.number}</span>
            </div>

            <p class="mt-6 text-xs font-bold uppercase tracking-[0.16em] text-slate-400">{service.audience}</p>
            <h3 class="mt-3 text-2xl font-black leading-tight text-slate-950">{service.title}</h3>
            <p class="mt-4 text-sm leading-7 text-slate-600">{service.description}</p>

            <ul class="mt-6 grid gap-3">
              {service.features.map((feature) => (
                <li class="flex items-center gap-3 text-sm font-semibold text-slate-700">
                  <span class:list={['flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs', colors.check]}>✓</span>
                  {feature}
                </li>
              ))}
            </ul>

            <a href="#contacto" class="mt-8 inline-flex items-center text-sm font-black text-slate-950 transition group-hover:text-blue-700">
              Platicar sobre este servicio
              <span class="ml-2 transition group-hover:translate-x-1">→</span>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</section>
